{
  "name": "sandbox-platform",
  "private": true,
  "scripts": {
    "dev": "dotenv -c -- turbo dev --filter=!@sandbox/nuxt-starter --filter=!@sandbox/agent-worker",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "cpu-features",
      "esbuild",
      "protobufjs",
      "ssh2"
    ]
  }
}